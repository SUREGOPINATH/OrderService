pipeline {
    agent any
	
	options {
        // Automatically cleans the workspace BEFORE checking out code
        timestamps()
    }

    environment {
        IMAGE_NAME = 'order-service'
        TAG = "${env.BUILD_NUMBER}"
        
        // Your exact credential ID and Docker Hub repository path
        DOCKER_HUB_CREDENTIALS_ID = 'Docker_Credentials' 
        DOCKER_IMAGE_REPO = 'gopinath3008/order-service'
    }

    stages {
	
		stage('Clean Workspace') {
            steps {
                cleanWs(deleteDirs: true, notFailBuild: true)
            }
        }
	
        stage('Checkout') {
            steps {
                cleanWs deleteDirs: true, notFailBuild: true
                // Explicitly force checkout from the master branch
                checkout([$class: 'GitSCM',
                    branches: [[name: '*/master']],
                    userRemoteConfigs: [[url: 'https://github.com/SUREGOPINATH/OrderService.git']]
                ])
            }
        }

        stage('Run Unit Tests') {
            steps {
                script {
                    sh '''
                        echo "=== Inspecting Workspace Directory ==="
                        find . -maxdepth 3 -ls
                        
                        echo "=== Locating Project File ==="
                        PROJECT_FILE=$(find . -name "*.csproj" | head -n 1)
                        
                        if [ -z "$PROJECT_FILE" ]; then
                            echo "ERROR: No .csproj file found in the workspace!"
                            exit 1
                        fi
                        
                        echo "Found project file at: $PROJECT_FILE"
                        
                        # Extract just the directory name to set as the container's working directory
                        PROJECT_DIR=$(dirname "$PROJECT_FILE")
                        PROJECT_NAME=$(basename "$PROJECT_FILE")
                        
                        echo "=== Running Unit Tests in Docker Container ==="
                        docker run --rm -v ${WORKSPACE}:/workspace -w /workspace/$PROJECT_DIR mcr.microsoft.com/dotnet/sdk:10.0 dotnet test "$PROJECT_NAME"
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${env.IMAGE_NAME}:${env.TAG} -t ${env.IMAGE_NAME}:latest ./OrderService"
                }
            }
        }

        stage('Smoke Test Container') {
            steps {
                script {
                    sh "docker run -d --name order-service-smoke -p 8080:8080 ${env.IMAGE_NAME}:${env.TAG}"
                    sleep 5
                    sh "curl -I http://localhost:8080 || exit 1"
                }
            }
            post {
                always {
                    script {
                        sh "docker stop order-service-smoke || true"
                        sh "docker rm order-service-smoke || true"
                    }
                }
            }
        }

        stage('Push to Container Registry') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${env.DOCKER_HUB_CREDENTIALS_ID}", 
                                                  usernameVariable: 'DOCKER_USER', 
                                                  passwordVariable: 'DOCKER_PASS')]) {
                    script {
                        sh "echo ${env.DOCKER_PASS} | docker login -u ${env.DOCKER_USER} --password-stdin"
                        sh "docker tag ${env.IMAGE_NAME}:${env.TAG} ${env.DOCKER_IMAGE_REPO}:${env.TAG}"
                        sh "docker tag ${env.IMAGE_NAME}:latest ${env.DOCKER_IMAGE_REPO}:latest"
                        sh "docker push ${env.DOCKER_IMAGE_REPO}:${env.TAG}"
                        sh "docker push ${env.DOCKER_IMAGE_REPO}:latest"
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully: Tested, Built, Smoke-Tested, and Pushed to Docker Hub!'
        }
        failure {
            echo 'Pipeline failed. Check the logs above for details.'
        }
    }
}