pipeline {
    agent any

    environment {
        IMAGE_NAME = 'order-service'
        TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Restore & Build .NET 10') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'dotnet restore OrderService/OrderService.csproj'
                        sh 'dotnet build OrderService/OrderService.csproj --configuration Release --no-restore'
                    } else {
                        bat 'dotnet restore OrderService/OrderService.csproj'
                        bat 'dotnet build OrderService/OrderService.csproj --configuration Release --no-restore'
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    if (isUnix()) {
                        sh "docker build -t ${env.IMAGE_NAME}:${env.TAG} -t ${env.IMAGE_NAME}:latest ./OrderService"
                    } else {
                        bat "docker build -t ${env.IMAGE_NAME}:${env.TAG} -t ${env.IMAGE_NAME}:latest ./OrderService"
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully! .NET 10 app built and containerized.'
        }
        failure {
            echo 'Pipeline failed. Check the logs above for details.'
        }
    }
}