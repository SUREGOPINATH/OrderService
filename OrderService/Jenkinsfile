pipeline {
    agent any

    environment {
        IMAGE_NAME = 'order-service'
        TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // Dockerfile handles dotnet restore, build, and publish internally
                    if (isUnix()) {
                        sh "docker build -t ${env.IMAGE_NAME}:${env.TAG} -t ${env.IMAGE_NAME}:latest ./OrderService"
                    } else {
                        bat "docker build -t ${env.IMAGE_NAME}:${env.TAG} -t ${env.IMAGE_NAME}:latest ./OrderService"
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully! .NET 10 app containerized via Docker.'
        }
        failure {
            echo 'Pipeline failed. Check the logs above for details.'
        }
    }
}