pipeline {
    agent any

    environment {
        IMAGE_NAME = 'order-service'
        TAG = ""
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Restore & Build .NET 10') {
            steps {
                bat 'dotnet restore OrderService.csproj'
                bat 'dotnet build OrderService.csproj --configuration Release --no-restore'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat "docker build -t : -t :latest ."
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully! .NET 10 app built and containerized.'
        }
        failure {
            echo 'Pipeline failed. Check the logs above for details.'
        }
    }
}